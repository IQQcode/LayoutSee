{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://layoutsee.local/schemas/plugin/manifest-v1.json",
  "title": "PluginManifestV1",
  "description": "历史清单契约，仅用于兼容读取；platforms 字段在存量数据里既出现过设备平台也出现过宿主端，升级读取时按 android/ios/harmony 取 devicePlatforms，其余值忽略。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version", "entry", "platforms", "permissions"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "entry": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+\\.html$" },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["android", "ios", "harmony", "macos"] }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["device.read", "device.write", "snapshot.read", "network.none"] }
    }
  }
}
